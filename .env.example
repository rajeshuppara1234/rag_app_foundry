# Copy values into your existing .env; never overwrite it or bake it into an image.
APP_ENV=development
PUBLIC_ORIGIN=http://localhost:8000

# Existing Foundry model deployments. Chat endpoint must include /openai/v1/.
FOUNDRY_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/openai/v1/
FOUNDRY_CHAT_MODEL=YOUR-CHAT-DEPLOYMENT
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=YOUR-EMBEDDING-DEPLOYMENT
AZURE_OPENAI_API_VERSION=2024-02-01
# Production uses managed identity when keys are omitted. For local dev: az login.
# FOUNDRY_API_KEY=...
# AZURE_OPENAI_API_KEY=...
# AZURE_CLIENT_ID=USER-ASSIGNED-MANAGED-IDENTITY-CLIENT-ID

CHROMA_URL=https://YOUR-CHROMA-APP.azurecontainerapps.io
CHROMA_COLLECTION=pdf_documents
CHROMA_TENANT=default_tenant
CHROMA_DATABASE=default_database
# Optional header for an authenticated Chroma reverse proxy.
# CHROMA_AUTH_HEADER=Authorization
# CHROMA_AUTH_TOKEN=Bearer ...

# External ID: separate SPA and API registrations in the same external tenant.
AUTH_AUTHORITY=https://YOUR-TENANT.ciamlogin.com/
AUTH_SPA_CLIENT_ID=SPA-APPLICATION-CLIENT-ID
AUTH_AUDIENCE=API-APPLICATION-CLIENT-ID
AUTH_SCOPE=api://API-APPLICATION-CLIENT-ID/access_as_user
AUTH_REQUIRED_SCOPE=access_as_user
# Copy these EXACTLY from your tenant's v2 OpenID configuration; do not guess.
AUTH_ISSUER=https://YOUR-TENANT-ID.ciamlogin.com/YOUR-TENANT-ID/v2.0
AUTH_JWKS_URL=https://YOUR-TENANT.ciamlogin.com/YOUR-TENANT-ID/discovery/v2.0/keys

REQUESTS_PER_MINUTE=10
TOTAL_REQUESTS_PER_MINUTE=60
MAX_CONCURRENT_REQUESTS=4
REQUEST_TIMEOUT_SECONDS=120
MAX_CONTEXT_CHARS=24000
MAX_ANSWER_TOKENS=1024
MODEL_TIMEOUT_SECONDS=45
MODEL_MAX_RETRIES=1
CHROMA_TIMEOUT_SECONDS=10
# Optional: calibrate against your collection's actual distance metric.
# MAX_DISTANCE=0.7
